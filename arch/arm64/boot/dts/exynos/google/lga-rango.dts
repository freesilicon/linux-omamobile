// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 10 Pro Fold (rango) Stage 1 clean-room DTS draft.
 *
 * Verified stock DTBO identity (non-PII):
 *   dtbo_idx = 10 (lga-rango-mp.dtbo), board_id = 0x70606, board_rev = 0x010000
 *   Stock dual panels: google-rgea (2152x2076@60) + google-rgeb (1080x2364@60)
 *   (no bootloader simple-framebuffer or cont_splash carveout exists)
 *
 * Do NOT add device serials, IMEIs, MACs, BT addresses, PSN, or /chosen/config.
 */

/dts-v1/;

#include "lga.dtsi"

/ {
	model = "Google Pixel 10 Pro Fold (rango) Stage 1";
	compatible = "google,lga-rango", "google,lga";
	board_id = <0x70606>;
	board_rev = <0x010000>;

	chosen {
		/* keep_bootcon retains earlycon if ttyS0 defers pending clk-cpm */
		bootargs = "earlycon=uart8250,mmio32,0xdb62000 console=ttyS0,115200n8 keep_bootcon google_8250.nr_uarts=4 clk_ignore_unused pd_ignore_unused panic=10 rdinit=/init";
	};
};

&uart16 {
	status = "okay";
};

&watchdog_cl0 {
	status = "okay";
};

&watchdog_cl1 {
	status = "okay";
};

/*
 * Stage 1B USB2 gadget (requires CPM power/clock/reset drivers or Stage 1A stubs
 * because dwc3-google enforces dev_pm_domain_attach_by_name("psw"/"top")).
 */
&usb_phy {
	status = "okay";
};

&usb {
	status = "okay";
};

&ldo_27s_reg {
	regulator-min-microvolt = <1850000>;
	regulator-max-microvolt = <1850000>;
};

&lsion_level_gia_4 {
	status = "okay";
};

&lsioe_level_gia_0 {
	status = "okay";
};

&lsioe_level_gia_4 {
	status = "okay";
};

&lsios_level_gia_0 {
	status = "okay";
};

&lsios_level_gia_4 {
	status = "okay";
};

&pinctrl_cpm {
	status = "okay";
};

&pinctrl_aoc {
	status = "okay";
};

&pinctrl_lsioe {
	status = "okay";
};

&pinctrl_lsios {
	status = "okay";
};

&i2c14 {
	status = "okay";

	s2dos07x02_outer: regulator@60 {
		compatible = "samsung,s2dos07x02";
		reg = <0x60>;
		regulator-name = "s2dos07x02-pmic";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <2100000>;
	};
};

&i2c4 {
	status = "okay";

	s2dos07x02_inner: regulator@60 {
		compatible = "samsung,s2dos07x02";
		reg = <0x60>;
		regulator-name = "s2dos07x02-inner-pmic";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <2100000>;
	};
};

&spi20 {
	status = "okay";

	touchscreen@0 {
		compatible = "synaptics,tcm-spi";
		reg = <0>;
		spi-max-frequency = <20000000>;
		rx-sample-delay-ns = <25>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts0_2_aoc_int_l_1v2 &pmics2ts0_reset_l_1v2>;
		vdd-supply = <&ldo_27s_reg>;
		avdd-supply = <&ldo_26s_reg>;
		reset-gpios = <&da9188_gpio 0x11 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&pinctrl_aoc>;
		interrupts = <0x41 IRQ_TYPE_LEVEL_LOW>;
		power-delay-ms = <200>;
		reset-active-ms = <20>;
		reset-delay-ms = <200>;
	};
};

&spi19 {
	status = "okay";

	touchscreen@0 {
		compatible = "st,fst2";
		reg = <0>;
		spi-max-frequency = <20000000>;
		rx-sample-delay-ns = <25>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts1_2_aoc_int_l_1v2 &pmics2ts1_reset_l_1v2>;
		vdd-supply = <&ldo_24m_reg>;
		avdd-supply = <&ldo_26m_reg>;
		reset-gpios = <&da9188_gpio 0x12 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&pinctrl_aoc>;
		interrupts = <0x42 IRQ_TYPE_LEVEL_LOW>;
		touchscreen-size-x = <2076>;
		touchscreen-size-y = <2152>;
		touchscreen-inverted-x;
	};
};

&gpio_keys {
	pinctrl-0 = <&vol_dn_l &vol_up_l &pmicm2ap_gsc_pwron_od_l &hall1_2_aoc_ap_l>;
	status = "okay";

	lid-switch {
		label = "SW_LID";
		linux,input-type = <EV_SW>;
		linux,code = <SW_LID>;
		gpios = <&pinctrl_cpm 0x38 GPIO_ACTIVE_LOW>;
		wakeup-source;
		status = "okay";
	};
};
