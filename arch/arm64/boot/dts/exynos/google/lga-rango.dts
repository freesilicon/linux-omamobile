// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Pixel 10 Pro Fold (rango) Stage 1 clean-room DTS draft.
 *
 * Verified stock DTBO identity (non-PII):
 *   dtbo_idx = 10 (lga-rango-mp.dtbo), board_id = 0x70606, board_rev = 0x010000
 *   Stock dual panels: google-rgea (2152x2076@60) + google-rgeb (1080x2364@60)
 *   (no bootloader simple-framebuffer or cont_splash carveout exists)
 *
 * Do NOT add device serials, IMEIs, MACs, BT addresses, PSN, or /chosen/config.
 */

/dts-v1/;

#include "lga.dtsi"

/ {
	model = "Google Pixel 10 Pro Fold (rango) Stage 1";
	compatible = "google,lga-rango", "google,lga";
	board_id = <0x70606>;
	board_rev = <0x010000>;

	chosen {
		/* keep_bootcon retains earlycon if ttyS0 defers pending clk-cpm */
		bootargs = "earlycon=uart8250,mmio32,0xdb62000 console=ttyS0,115200n8 keep_bootcon google_8250.nr_uarts=4 clk_ignore_unused pd_ignore_unused panic=10 rdinit=/init";
	};
};

&uart16 {
	status = "okay";
};

&watchdog_cl0 {
	status = "okay";
};

&watchdog_cl1 {
	status = "okay";
};

/*
 * Stage 1B USB2 gadget (requires CPM power/clock/reset drivers or Stage 1A stubs
 * because dwc3-google enforces dev_pm_domain_attach_by_name("psw"/"top")).
 */
&usb_phy {
	status = "okay";
};

&usb {
	status = "okay";
};

&cpuacc_level_gia {
	status = "okay";
};

&cpuacc_pulse_gia {
	status = "okay";
};

&amb_smmu {
	status = "okay";
};

&gsa_mba_syscon {
	status = "okay";
};

&gsa_ap_0_mba {
	status = "okay";
};

&gsa {
	status = "okay";
};

&tpu_level_gia {
	status = "okay";
};

&tpu_pulse_gia {
	status = "okay";
};

&tpu_smmu {
	status = "okay";
};

&sswrp_tpu {
	status = "okay";
};

&buenos {
	status = "okay";
};

&ldo_27s_reg {
	regulator-min-microvolt = <1850000>;
	regulator-max-microvolt = <1850000>;
};

&lsion_level_gia_4 {
	status = "okay";
};

&lsioe_level_gia_0 {
	status = "okay";
};

&lsioe_level_gia_4 {
	status = "okay";
};

&lsios_level_gia_0 {
	status = "okay";
};

&lsios_level_gia_4 {
	status = "okay";
};

&pinctrl_cpm {
	status = "okay";
};

&pinctrl_aoc {
	status = "okay";
};

&pinctrl_lsioe {
	status = "okay";
};

&pinctrl_lsios {
	gpio-reserved-ranges = <0xf 0x4 0x36 0x1>;
	status = "okay";
};

&i2c14 {
	status = "okay";

	s2dos07x02_outer: regulator@60 {
		compatible = "samsung,s2dos07x02";
		reg = <0x60>;
		regulator-name = "s2dos07x02-pmic";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <2100000>;
	};
};

&i2c4 {
	status = "okay";

	s2dos07x02_inner: regulator@60 {
		compatible = "samsung,s2dos07x02";
		reg = <0x60>;
		regulator-name = "s2dos07x02-inner-pmic";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <2100000>;
	};
};

&spi20 {
	status = "okay";

	touchscreen@0 {
		compatible = "synaptics,tcm-spi";
		reg = <0>;
		spi-max-frequency = <20000000>;
		rx-sample-delay-ns = <25>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts0_2_aoc_int_l_1v2>;
		vdd-supply = <&ldo_27s_reg>;
		avdd-supply = <&ldo_26s_reg>;
		reset-gpios = <&da9188_gpio 0x11 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&pinctrl_aoc>;
		interrupts = <0x41 IRQ_TYPE_LEVEL_LOW>;
		power-delay-ms = <200>;
		reset-active-ms = <20>;
		reset-delay-ms = <200>;
	};
};

&spi19 {
	status = "okay";

	touchscreen@0 {
		compatible = "st,fst2";
		reg = <0>;
		spi-max-frequency = <20000000>;
		rx-sample-delay-ns = <25>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts1_2_aoc_int_l_1v2>;
		vdd-supply = <&ldo_24m_reg>;
		avdd-supply = <&ldo_26m_reg>;
		reset-gpios = <&da9188_gpio 0x12 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&pinctrl_aoc>;
		interrupts = <0x42 IRQ_TYPE_LEVEL_LOW>;
		touchscreen-size-x = <2076>;
		touchscreen-size-y = <2152>;
		touchscreen-inverted-x;
	};
};

&gpio_keys {
	pinctrl-0 = <&vol_dn_l &vol_up_l &pmicm2ap_gsc_pwron_od_l &hall1_2_aoc_ap_l>;
	status = "okay";

	lid-switch {
		label = "SW_LID";
		linux,input-type = <EV_SW>;
		linux,code = <SW_LID>;
		gpios = <&pinctrl_cpm 0x38 GPIO_ACTIVE_LOW>;
		wakeup-source;
		status = "okay";
	};
};

&dpu_level_gia {
	status = "okay";
};

&sswrp_dpu {
	status = "okay";
};

&dw_mipi_g301_cdphy0 {
	status = "okay";
};

&dsi2h0 {
	status = "okay";
	datarate = <865>;

	panel0: panel@0 {
		compatible = "google,gs-rgeb";
		reg = <0>;
		vci-supply = <&ldo_18s_reg>;
		vddd-supply = <&s2dos07x02_outer>;
		reset-gpios = <&da9188_gpio 0xb GPIO_ACTIVE_HIGH>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&dsi0_port1_out>;
			};
		};
	};
};

&dsi0_port1_out {
	remote-endpoint = <&panel0_in>;
};

&dsi2h1 {
	status = "disabled";
	datarate = <1468>;
	#address-cells = <1>;
	#size-cells = <0>;

	panel1: panel@0 {
		compatible = "google,gs-rgea";
		reg = <0>;
		vci-supply = <&ldo_14m_reg>;
		vddd-supply = <&s2dos07x02_inner>;

		port {
			panel1_in: endpoint {
				remote-endpoint = <&dsi1_port1_out>;
			};
		};
	};
};

&dsi1_port1_out {
	remote-endpoint = <&panel1_in>;
};

&dpu {
	status = "okay";
};

&gpu_stage0_probe {
	status = "okay";
};

&spmi0 {
	master_arb_en = <0>;
	prescalar = <4>;
	status = "okay";
};

&max77779_fg {
	status = "okay";
};

&hsios_level_gia_6 {
	status = "okay";
};

&inftcu_level_gia_3 {
	status = "okay";
};

&inftcu_pulse_gia_0 {
	status = "okay";
};

&inf_smmu {
	status = "okay";
};

&pinctrl_hsios_stby {
	status = "okay";
};

&pinctrl_hsios {
	status = "okay";
};

&ufs0 {
	google,enable-phy-calibration;
	google,toggle-resetb-on-reset;
	phy-cal-data = <0x2dd3129 0x2f23329 0x76311e 0x76331e 0x723120 0x723320 0x723122 0x703322
			0x723124 0x703324 0x1ffe0162 0x3021 0x3221 0x80803022 0x80803222
			0x80803023 0x80803223 0x3039 0x3239 0x313c 0x333c 0x2010313d 0x2010333d
			0x2010313e 0x200d333e 0x2014313f 0x200e333f 0x20103140 0x20103340
			0x20103141 0x200d3341 0x20143142 0x200e3342 0x24383143 0x24383343
			0x24383144 0x24383344 0x3145 0x3345 0x3146 0x3346 0x1f690163 0xf3024
			0xf3224 0x7ea33025 0x7ea03225 0x80803026 0x80803226 0x1303a 0x1323a
			0xf3147 0xf3347 0x20103148 0x20103348 0x23303149 0x208d3349 0x2054314a
			0x226e334a 0x2010314b 0x2010334b 0x2010314c 0x200d334c 0x2014314d
			0x200e334d 0x2438314e 0x2338334e 0x2438314f 0x2438334f 0x13150 0x13350
			0x3151 0x3351>;
	status = "okay";
};
