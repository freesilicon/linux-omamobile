/*
 * Google Pixel 10 Pro XL (mustang) Stage 1 clean-room DTS draft.
 *
 * Verified stock DTBO identity (non-PII):
 *   dtbo_idx = 30 (lga-mustang-mp.dtbo), board_id = 0x70506, board_rev = 0x010000
 *   Stock panel@0: google-mtea, mode 1344x2992@60 (no bootloader simple-framebuffer)
 *
 * Do NOT add device serials, IMEIs, MACs, BT addresses, PSN, or /chosen/config.
 */

/dts-v1/;

#include "lga.dtsi"

/ {
	model = "Google Pixel 10 Pro XL (mustang) Stage 1";
	compatible = "google,lga-mustang", "google,lga";
	board_id = <0x70506>;
	board_rev = <0x010000>;

	chosen {
		/* keep_bootcon retains earlycon if ttyS0 defers pending clk-cpm */
		bootargs = "earlycon=uart8250,mmio32,0xdb62000 console=ttyS0,115200n8 keep_bootcon google_8250.nr_uarts=4 clk_ignore_unused pd_ignore_unused panic=10 rdinit=/init";
	};
};

&uart16 {
	status = "okay";
};

&watchdog_cl0 {
	status = "okay";
};

&watchdog_cl1 {
	status = "okay";
};

/*
 * Stage 1B USB2 gadget (requires CPM power/clock/reset drivers or Stage 1A stubs
 * because dwc3-google enforces dev_pm_domain_attach_by_name("psw"/"top")).
 */
&usb_phy {
	status = "okay";
};

&usb {
	status = "okay";
};

&cpuacc_level_gia {
	status = "okay";
};

&cpuacc_pulse_gia {
	status = "okay";
};

&amb_smmu {
	status = "okay";
};

&gsa_mba_syscon {
	status = "okay";
};

&gsa_ap_0_mba {
	status = "okay";
};

&gsa {
	status = "okay";
};

&tpu_level_gia {
	status = "okay";
};

&tpu_pulse_gia {
	status = "okay";
};

&tpu_smmu {
	status = "okay";
};

&sswrp_tpu {
	status = "okay";
};

&buenos {
	status = "okay";
};

&lsion_level_gia_4 {
	status = "okay";
};

&lsioe_level_gia_0 {
	status = "okay";
};

&lsioe_level_gia_4 {
	status = "okay";
};

&pinctrl_cpm {
	status = "okay";
};

&pinctrl_aoc {
	status = "okay";
};

&pinctrl_lsioe {
	status = "okay";
};

&pinctrl_lsios {
	gpio-reserved-ranges = <0x28 0x4 0x36 0x1>;
};

&i2c14 {
	status = "okay";

	s2dos07x02_outer: regulator@60 {
		compatible = "samsung,s2dos07x02";
		reg = <0x60>;
		regulator-name = "s2dos07x02-pmic";
		regulator-min-microvolt = <850000>;
		regulator-max-microvolt = <2100000>;
	};
};

&spi20 {
	status = "okay";

	touchscreen@0 {
		compatible = "synaptics,tcm-spi";
		reg = <0>;
		spi-max-frequency = <20000000>;
		rx-sample-delay-ns = <25>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts0_2_aoc_int_l_1v2>;
		vdd-supply = <&ldo_27s_reg>;
		avdd-supply = <&ldo_26s_reg>;
		reset-gpios = <&da9188_gpio 0x11 GPIO_ACTIVE_LOW>;
		interrupt-parent = <&pinctrl_aoc>;
		interrupts = <0x41 IRQ_TYPE_LEVEL_LOW>;
		power-delay-ms = <200>;
		reset-active-ms = <1>;
		reset-delay-ms = <70>;
	};
};

&gpio_keys {
	status = "okay";
};

&dpu_level_gia {
	status = "okay";
};

&sswrp_dpu {
	status = "okay";
};

&dw_mipi_g301_cdphy0 {
	status = "okay";
};

&dsi2h0 {
	status = "okay";
	datarate = <1368>;

	panel0: panel@0 {
		compatible = "google,gs-mtea";
		reg = <0>;
		vci-supply = <&ldo_18s_reg>;
		vddd-supply = <&s2dos07x02_outer>;
		reset-gpios = <&da9188_gpio 0xb GPIO_ACTIVE_HIGH>;

		port {
			panel0_in: endpoint {
				remote-endpoint = <&dsi0_port1_out>;
			};
		};
	};
};

&dsi0_port1_out {
	remote-endpoint = <&panel0_in>;
};

&dpu {
	status = "okay";
};

&gpu_stage0_probe {
	status = "okay";
};

&spmi0 {
	master_arb_en = <1>;
	prescalar = <1>;
	status = "okay";
};

&max77779_fg {
	status = "okay";
};

&hsios_level_gia_6 {
	status = "okay";
};

&inftcu_level_gia_3 {
	status = "okay";
};

&inftcu_pulse_gia_0 {
	status = "okay";
};

&inf_smmu {
	status = "okay";
};

&pinctrl_hsios_stby {
	status = "okay";
};

&pinctrl_hsios {
	status = "okay";
};

&ufs0 {
	google,enable-phy-calibration;
	google,toggle-resetb-on-reset;
	phy-cal-data = <0x2f13129 0x2f63329 0x7e311e 0x7a331e 0x803120 0x783320 0x803122 0x7a3322
			0x823124 0x7a3324 0x1f7b0162 0x3021 0x3221 0x80803022 0x80803222
			0x80803023 0x80803223 0x3039 0x3239 0x313c 0x333c 0x2010313d 0x2010333d
			0x200e313e 0x2010333e 0x2011313f 0x200e333f 0x20103140 0x20103340
			0x200e3141 0x20103341 0x20113142 0x200e3342 0x24383143 0x24383343
			0x24383144 0x24383344 0x3145 0x3345 0x3146 0x3346 0x1f650163 0xf3024
			0xf3224 0x78a03025 0x7d9d3225 0x80803026 0x80803226 0x1303a 0x1323a
			0xf3147 0xf3347 0x20103148 0x20103348 0x1bae3149 0x20503349 0x2071314a
			0x1bce334a 0x2010314b 0x2010334b 0x200e314c 0x2010334c 0x2011314d
			0x200e334d 0x2238314e 0x2338334e 0x2438314f 0x2438334f 0x13150 0x13350
			0x3151 0x3351>;
	status = "okay";
};

/ {
	wlan_reg_on: regulator-wlan-reg-on {
		compatible = "regulator-fixed";
		regulator-name = "wlan-reg-on";
		gpio = <&pinctrl_hsios 13 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;
		pinctrl-names = "default";
		pinctrl-0 = <&ap2wlan_reg_on_1v2>;
	};
};

&hsios_pulse_gia_3 {
	status = "okay";
};

&hsios_pulse_gia_4 {
	status = "okay";
};

&pcie1 {
	status = "okay";

	pcie@0,0 {
		compatible = "pciclass,0604";
		device_type = "pci";
		reg = <0x0 0x0 0x0 0x0 0x0>;
		bus-range = <0x01 0xff>;
		#address-cells = <3>;
		#size-cells = <2>;
		ranges;
		vpcie3v3-supply = <&wlan_reg_on>;

		wifi@0,0 {
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			brcm,board-type = "google,lga-mustang";
		};
	};
};

&ldo_14m_reg {
	google,monitor-only;
};

&ldo_24m_reg {
	google,monitor-only;
};

&ldo_26m_reg {
	google,monitor-only;
};

&ldo_10s_reg {
	google,monitor-only;
};
