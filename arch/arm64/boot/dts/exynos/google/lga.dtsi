			interrupt-controller;
			#interrupt-cells = <1>;
			reg = <0x0 0x0ef88000 0x0 0x50>;
			nr-irq-chips = <5>;
			next-bank-offset = <4>;
			interrupts = <GIC_SPI 820 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&sswrp_dpu_pd>;
			status = "disabled";
		};

		sswrp_dpu: sswrp_dpu@ec00000 {
			compatible = "simple-bus";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0x0ec00000 0x400000>;
			status = "disabled";

			dpu: dc9x00@200000 {
				compatible = "verisilicon,dc9x00";
				reg = <0x200000 0x120000>, <0x390000 0x10000>;
				reg-names = "dpu-fe-be", "dpu-gpcsr";
				interrupt-parent = <&dpu_level_gia>;
				interrupts = <0x24>, <0x25>, <0x26>, <0x29>;
				interrupt-names = "outpath0_frm_start",
						  "outpath0_frm_done",
						  "outpath0_underrun",
						  "output0_te_rising_edge";
				power-domains = <&dpu_dsi0_pd>, <&dpu_fe0_pd>;
				power-domain-names = "dpu_dsi0_pd", "dpu_fe0_pd";
				status = "disabled";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0>;

						dc_port0_dsi0_out: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&dsi0_ep0_in>;
						};

						dc_port0_dsi1_out: endpoint@1 {
							reg = <1>;
							remote-endpoint = <&dsi1_ep0_in>;
						};
					};
				};
			};

			dw_mipi_g301_cdphy0: dw_mipi_cdphy@3c0000 {
				compatible = "synopsys,dw-mipi-cdphy-v1";
				reg = <0x3c0000 0x18000>, <0x3d8800 0x800>;
				reg-names = "cdphy-tx", "u0-apb-regbank";
				#phy-cells = <1>;
				clocks = <&hsios_mphy_ref_clk>;
				clock-names = "pllref";
				power-domains = <&dpu_dsi0_pd>;
				status = "disabled";
			};

			dsi2h0: dsi2host@3d8000 {
				compatible = "verisilicon,dc9x00-mipi-dsi2h";
				reg = <0x3d8000 0x800>;
				interrupt-parent = <&dpu_level_gia>;
				interrupts = <0x78>;
				interrupt-names = "dsi0_irq";
				power-domains = <&dpu_dsi0_pd>;
				phys = <&dw_mipi_g301_cdphy0 0>;
				phy-names = "dw-mipi-cdphy";
				datarate = <1368>;
				sys_clk = <400000>;
				ipi_clk = <75000>;
				lptx_clk = <20000>;
				lp2hs_time = <0x009b00d4>;
				hs2lp_time = <0x006a80cc>;
				ppi_width = <1>;
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0>;

						dsi0_ep0_in: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&dc_port0_dsi0_out>;
						};
					};

					port@1 {
						reg = <1>;

						dsi0_port1_out: endpoint {
						};
					};
				};
			};

			dw_mipi_g301_cdphy1: dw_mipi_cdphy@3e0000 {
				compatible = "synopsys,dw-mipi-cdphy-v1";
				reg = <0x3e0000 0x18000>, <0x3f8800 0x800>;
				reg-names = "cdphy-tx", "u0-apb-regbank";
				#phy-cells = <1>;
				clocks = <&hsios_mphy_ref_clk>;
				clock-names = "pllref";
				power-domains = <&dpu_dsi1_pd>;
				status = "disabled";
			};

			dsi2h1: dsi2host@3f8000 {
				compatible = "verisilicon,dc9x00-mipi-dsi2h";
				reg = <0x3f8000 0x800>;
				interrupt-parent = <&dpu_level_gia>;
				interrupts = <0x79>;
				interrupt-names = "dsi1_irq";
				power-domains = <&dpu_dsi1_pd>;
				phys = <&dw_mipi_g301_cdphy1 0>;
				phy-names = "dw-mipi-cdphy";
				datarate = <1468>;
				sys_clk = <400000>;
				ipi_clk = <75000>;
				lptx_clk = <20000>;
				lp2hs_time = <0x009b00d4>;
				hs2lp_time = <0x006a80cc>;
				ppi_width = <1>;
				status = "disabled";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0>;

						dsi1_ep0_in: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&dc_port0_dsi1_out>;
						};
					};

					port@1 {
						reg = <1>;

						dsi1_port1_out: endpoint {
						};
					};
				};
			};
		};

		gpu_stage0_probe: gpu-stage0-probe@3480a000 {
			compatible = "google,laguna-gpu-stage0-probe";
			reg = <0x0 0x3480a000 0x0 0x4>,
			      <0x0 0x34826000 0x0 0x400>,
			      <0x0 0x34820a30 0x0 0x10>,
			      <0x0 0x34855c40 0x0 0x10>,
			      <0x0 0x34f00000 0x0 0x100>;
			reg-names = "gpu_control", "pvtc", "pvtc_pwroff", "dts", "rgx";
			power-domains = <&sswrp_gpu_pd>;
			status = "disabled";
		};

		gpu_smmu: iommu@34c00000 {
			compatible = "arm,smmu-v3";
			reg = <0x0 0x34c00000 0x0 0x40000>;
			dma-coherent;
			power-domains = <&sswrp_gpu_pd>;
			#iommu-cells = <1>;
			arm,instdata-override;
			arm,max-sid-bits = <8>;
			status = "disabled";
		};

		gpu0: gpu@34f00000 {
			compatible = "google,lga-gpu", "img,img-volcanic";
			reg = <0x0 0x34f00000 0x0 0x100000>,
			      <0x0 0x34813000 0x0 0xc>,
			      <0x0 0x34e08000 0x0 0x1000>,
			      <0x0 0x34900200 0x0 0x200>,
			      <0x0 0x34901200 0x0 0x200>,
			      <0x0 0x34902200 0x0 0x200>,
			      <0x0 0x34e40000 0x0 0x48>,
			      <0x0 0x34ea0000 0x0 0x4000>,
			      <0x0 0x3480a000 0x0 0x4>,
			      <0x0 0x34826000 0x0 0x400>,
			      <0x0 0x34820a30 0x0 0x10>,
			      <0x0 0x34855c40 0x0 0x10>;
			reg-names = "rgx", "pfsm", "req_pbha_lut",
				    "ra_lut_0", "ra_lut_1", "ra_lut_2",
				    "mba_glue", "mba_client",
				    "gpu_control", "pvtc", "pvtc_pwroff", "dts";
			interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&sswrp_gpu_pd>;
			iommus = <&gpu_smmu 0>, <&gpu_smmu 1>;
			iommu-idmapped;
			dma-coherent;
			memory-region = <&gpu_fw_rmem>;
			status = "disabled";
		};
	};

	gsa: gsa {
		compatible = "google,gs101-gsa-v1";
		log-region = <&gsa_reserved_log>;
		iommus = <&amb_smmu 0x8201>;
		mboxes = <&gsa_ap_0_mba 0>;
		mbox-channels = <1>;
		channel-max-pending-msgs = <1>;
		status = "disabled";
	};

	trusty: trusty {
		compatible = "android,trusty-smc-v1";

		irq {
			compatible = "android,trusty-irq-v1";
			ipi-range = <0x8 0xf 0x8>;
		};

		log {
			compatible = "android,trusty-log-v1";
		};

		virtio {
			compatible = "android,trusty-virtio-v1";
		};
	};
};
