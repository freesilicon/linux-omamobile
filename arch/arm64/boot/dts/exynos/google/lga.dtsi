			cli14_2_wire_sleep: cli14_2_wire_sleep {
				pins = "XLSIOE_CLI14_PIN0", "XLSIOE_CLI14_PIN1";
				function = "lsioe_gpio";
				bias-pull-up;
				output-disable;
				input-enable;
			};
		};

