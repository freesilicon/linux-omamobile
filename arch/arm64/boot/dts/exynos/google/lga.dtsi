// SPDX-License-Identifier: GPL-2.0-only
/*
 * Google Tensor G5 (Laguna / google,lga) Stage 1 clean-room SoC description.
 *
 * Derived cleanly from live Pixel 10 (mustang/rango) FDT / /proc/iomem captures,
 * stock CP3A.261005.005 module interfaces, and mainline v7.3-rc6 bindings
 * (derekross/linux-omamobile).
 *
 * Notice:
 * - No proprietary firmware blobs, serial numbers, IMEIs, or MAC addresses.
 * - Stage 1 targets (CPM MBA, clk-cpm, rst-cpm, power_controller, WDT, UART0,
 *   USB2 DWC3/PHY) are enabled or wired; Stage 2 blocks (GIA, pinctrl, SMMUv3,
 *   GSA, EdgeTPU, UFS, DPU) are included as disabled stubs for address/IRQ/SID
 *   reference.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	compatible = "google,lga";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	/* Required by Documentation/devicetree/bindings/arm/google.yaml & OmaMobile §5.3 */
	ect { };

	dpm: dpm { };

	/* Verified on live mustang & rango B0 hardware (A0 sibling optional) */
	soc_compatible {
		B0 {
			description = "LGA B0";
			product_id = <0x5>;
			major = <0x1>;
			minor = <0x0>;
			pkg_mode = <0x0>;
		};
	};

	aliases {
		serial0 = &uart16;
		serial2 = &uart9;
		ufs0 = &ufs0;
	};

	/*
	 * Stock pre-ABL placeholder; ABL populates the full 16 GiB across 8 banks
	 * (0x80000000 + 0x880000000..0xb80000000) dynamically via fdt_add_subnode.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x10000000>;
	};

	/*
	 * Reserved regions cross-checked against live mustang/rango /proc/iomem.
	 * Note: live /proc/iomem also shows 0x880000000-0x880ffffff and
	 * 0xbbe380000-0xbd55fffff reserved dynamically by firmware/EL2.
	 * Note: NO cont_splash / simple-framebuffer region exists on stock ABL.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		nvmem@53d1000 {
			compatible = "nvmem-rmem";
			reg = <0x0 0x053d1000 0x0 0x480>;
			no-map;
		};

		boot_metadata@543e000 {
			reg = <0x0 0x0543e000 0x0 0x2000>;
			no-map;
		};

		cp_aoc_rmem@900c000 {
			compatible = "exynos,modem_if";
			reg = <0x0 0x0900c000 0x0 0x3000>;
		};

		xhci_dma@9010000 {
			compatible = "xhci-dma-pool";
			reg = <0x0 0x09010000 0x0 0x40000>;
			no-map;
		};

		xhci_dma_buffer@9050000 {
			compatible = "xhci-dma-pool";
			reg = <0x0 0x09050000 0x0 0xc000>;
			no-map;
		};

		/*
		 * Note: pkvm_guest_firmware@8af00000, sec_dram@f7000000, and
		 * bl31_dram@ffe00000 are injected dynamically by ABL via fdt_add_subnode
		 * and abort with -FDT_ERR_EXISTS (-2) if pre-declared here.
		 */
		cpu_stats_carveout@8b20f000 {
			compatible = "cpu-stats-carveout";
			reg = <0x0 0x8b20f000 0x0 0x1000>;
			no-map;
		};

		gdmc_tracepoint_dma_buff@8b400000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x8b400000 0x0 0x20000>;
			no-map;
		};

		goog_mba_gdmc_iface_dma_region@8b420000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x8b420000 0x0 0x4000>;
			no-map;
		};

		goog_bl31_mem_log_buff@8b600000 {
			reg = <0x0 0x8b600000 0x0 0x200000>;
			no-map;
		};

		aoc_rmem: aoc@8d200000 {
			reg = <0x0 0x8d200000 0x0 0x3000000>;
			no-map;
		};

		cdd_log_reserved@90700000 {
			reg = <0x0 0x90700000 0x0 0x10000>;
			no-map;
		};

		debug_kinfo_reserved@90714000 {
			reg = <0x0 0x90714000 0x0 0x4000>;
			no-map;
		};

		cdd@91200000 {
			reg = <0x0 0x91200000 0x0 0x400000>;
			no-map;
		};

		cdd_header@951f8000 {
			reg = <0x0 0x951f8000 0x0 0x8000>;
			no-map;
		};

		ramoops@95200000 {
			compatible = "ramoops";
			reg = <0x0 0x95200000 0x0 0x400000>;
			console-size = <0x200000>;
			pmsg-size = <0x200000>;
		};

		bldr_log_reserved@95600000 {
			reg = <0x0 0x95600000 0x0 0x100000>;
			no-map;
		};

		xhci_dma_dram@97000000 {
			compatible = "xhci-dma-pool";
			reg = <0x0 0x97000000 0x0 0x400000>;
			no-map;
		};

		tpu_fw_rmem: tpu_fw@9fc00000 {
			reg = <0x0 0x9fc00000 0x0 0x1400000>;
			no-map;
		};

		vpu_fw@a1000000 {
			reg = <0x0 0xa1000000 0x0 0x200000>;
		};

		iif_wait_table@a1360000 {
			reg = <0x0 0xa1360000 0x0 0x20000>;
			no-map;
		};

		iif_signal_table@a1380000 {
			reg = <0x0 0xa1380000 0x0 0x20000>;
			no-map;
		};

		gxp_secure_data@a1400000 {
			reg = <0x0 0xa1400000 0x0 0x900000>;
			no-map;
		};

		gxp_fw@a1d00000 {
			reg = <0x0 0xa1d00000 0x0 0x300000>;
			no-map;
		};

		gxp_mcu_fw@a2000000 {
			reg = <0x0 0xa2000000 0x0 0x400000>;
			no-map;
		};

		gsa_gme: gsa-gme@a2400000 {
			reg = <0x0 0xa2400000 0x0 0x3db0000>;
			no-map;
		};

		gsa_reserved_log: gsa_reserved_log@a61b0000 {
			reg = <0x0 0xa61b0000 0x0 0x4000>;
			no-map;
		};

		gpu_fw_rmem: gpu_fw@b9f00000 {
			reg = <0x0 0xb9f00000 0x0 0x2100000>;
			no-map;
		};

		abl@be000000 {
			reg = <0x0 0xbe000000 0x0 0x1000000>;
			no-map;
		};

		famodel@c0000000 {
			reg = <0x0 0xc0000000 0x0 0x4b00000>;
		};

		farawimg@c4b00000 {
			reg = <0x0 0xc4b00000 0x0 0x5000000>;
		};

		cp_rmem_1@e8000000 {
			compatible = "exynos,modem_if";
			reg = <0x0 0xe8000000 0x0 0x2000000>;
		};

		cp_rmem@ea400000 {
			compatible = "exynos,modem_if";
			reg = <0x0 0xea400000 0x0 0xc00000>;
		};

		cp_msi_rmem@f6200000 {
			compatible = "exynos,modem_if";
			reg = <0x0 0xf6200000 0x0 0x1000>;
		};

		gc_rmem@f6fce000 {
			reg = <0x0 0xf6fce000 0x0 0x32000>;
			no-map;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x18000000>;
			alignment = <0x0 0x400000>;
			linux,cma-default;
		};
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
				core4 {
					cpu = <&cpu4>;
				};
				core5 {
					cpu = <&cpu5>;
				};
				core6 {
					cpu = <&cpu6>;
				};
				core7 {
					cpu = <&cpu7>;
				};
			};
		};

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x0>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x102>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x102>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x37b>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x37b>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x37b>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x37c>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x37c>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,armv8";
			reg = <0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <0x400>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	/* Note: stock FDT uses 0x108 ((1 << 8) | IRQ_TYPE_LEVEL_LOW); 4th cell = 0 */
	timer {
		compatible = "arm,armv8-timer";
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW 0>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW 0>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW 0>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW 0>;
	};

	oscillator: oscillator {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <38400000>;
	};

	/* Fixed USB leaf clocks present in stock FDT (used by 6.6 snps,dwc3, not mainline google,lga-dwc3) */
	usb_ref_clk: usb-ref-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <19200000>;
	};

	usb_bus_clk: usb-bus-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <250000000>;
	};

	usb_suspend_clk: usb-suspend-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <200000>;
	};


	goog_mba_cpm_iface: cpm-iface {
		compatible = "google,mba-cpm-iface";
	#mbox-cells = <0>;
		mboxes = <&cpm_ap_ns_req_mba_client_0 0>,
			 <&cpm_ap_ns_req_mba_client_0 1>,
			 <&cpm_ap_ns_req_mba_client_0 2>,
			 <&cpm_ap_ns_req_mba_client_0 3>,
			 <&cpm_ap_ns_req_mba_client_0 4>,
			 <&cpm_ap_ns_req_mba_client_0 5>,
			 <&cpm_ap_ns_req_mba_client_0 6>,
			 <&cpm_ap_ns_req_mba_client_0 7>,
			 <&cpm_ap_ns_resp_mba_client_1 0>,
			 <&cpm_ap_ns_resp_mba_client_1 1>,
			 <&cpm_ap_ns_resp_mba_client_1 2>,
			 <&cpm_ap_ns_resp_mba_client_1 3>;
		req-mboxes-idx = <0 1 2 3 4 5 6 7>;
		resp-mboxes-idx = <8 9 10 11>;
		payload-size = <4>;
		status = "okay";
	};

	power_controller: power-controller {
		compatible = "google,lga-power-controller";
		mboxes = <&goog_mba_cpm_iface>;

		sswrp_dpu_pd: sswrp_dpu_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x5>;
		};

		sswrp_lsio_s_pd: sswrp_lsio_s_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x1e>;
			on-at-init;
			rpm-always-on;
		};

		lsio_s_cli_gpio_pd: lsio_s_cli_gpio_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x1e>;
			power-domains = <&sswrp_lsio_s_pd>;
			subdomain-id = <0x0>;
			on-at-init;
		};

		sswrp_lsio_e_pd: sswrp_lsio_e_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x1c>;
			on-at-init;
			rpm-always-on;
		};

		lsio_e_cli_gpio_pd: lsio_e_cli_gpio_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x1c>;
			power-domains = <&sswrp_lsio_e_pd>;
			subdomain-id = <0x0>;
			on-at-init;
			rpm-always-on;
			use-smc;
		};

		sswrp_aoc_pd: sswrp_aoc_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x0>;
			on-at-init;
		};

		sswrp_lsio_n_pd: sswrp_lsio_n_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x1d>;
			on-at-init;
			rpm-always-on;
		};

		lsio_n_cli_gpio_pd: lsio_n_cli_gpio_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x1d>;
			power-domains = <&sswrp_lsio_n_pd>;
			subdomain-id = <0x0>;
			on-at-init;
			rpm-always-on;
		};

		sswrp_hsio_n_pd: sswrp_hsio_n_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x17>;
			on-at-init;
			rpm-always-on;
		};

		hsio_n_usb_pd: hsio_n_usb_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x17>;
			power-domains = <&sswrp_hsio_n_pd>;
			subdomain-id = <0x0>;
			on-at-init;
			active-wakeup;
		};

		hsio_n_usb_psw_pd: hsio_n_usb_psw_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x17>;
			power-domains = <&hsio_n_usb_pd>;
			subdomain-id = <0x5>;
			on-at-init;
			active-wakeup;
		};

		sswrp_hsio_s_pd: sswrp_hsio_s_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x18>;
			on-at-init;
			rpm-always-on;
		};

		sswrp_tpu_pd: sswrp_tpu_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x20>;
			active-wakeup;
			no-auto-resume;
		};

		dpu_dsi0_pd: dpu_dsi0_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x5>;
			power-domains = <&sswrp_dpu_pd>;
			subdomain-id = <0x2>;
		};

		dpu_dsi1_pd: dpu_dsi1_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x5>;
			power-domains = <&sswrp_dpu_pd>;
			subdomain-id = <0x3>;
		};

		dpu_fe0_pd: dpu_fe0_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x5>;
			power-domains = <&dpu_dsi0_pd>;
			subdomain-id = <0x0>;
		};

		dpu_fe1_pd: dpu_fe1_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x5>;
			power-domains = <&dpu_fe0_pd>;
			subdomain-id = <0x1>;
		};

		sswrp_gpu_pd: sswrp_gpu_pd {
			#power-domain-cells = <0>;
			sswrp-id = <0x14>;
		};
	};

	cpm_clk: clock-controller {
		compatible = "google,cpm-clk";
		mboxes = <&goog_mba_cpm_iface>;
		power-domains = <&sswrp_lsio_n_pd>, <&sswrp_lsio_e_pd>,
				<&sswrp_lsio_s_pd>, <&sswrp_hsio_n_pd>,
				<&sswrp_hsio_s_pd>;

		lsioe_gpio_clk: lsioe_gpio_clk {
			#clock-cells = <0>;
			lpcm-id = <0x2>;
			clock-id = <0x0>;
			use-smc;
		};

		lsios_gpio_clk: lsios_gpio_clk {
			#clock-cells = <0>;
			lpcm-id = <0x4>;
			clock-id = <0x0>;
		};

		lsioe_cli14_cfg_clk: lsioe_cli14_cfg_clk {
			#clock-cells = <0>;
			lpcm-id = <0x2>;
			clock-id = <0x8>;
			rates = <0x0 0x11e1a300>; /* 300 MHz */
		};

		lsioe_cli14_i2c_clk: lsioe_cli14_i2c_clk {
			#clock-cells = <0>;
			lpcm-id = <0x2>;
			clock-id = <0x18>;
			rates = <0x0 0x0bebc200>; /* 200 MHz */
		};

		lsios_cli4_cfg_clk: lsios_cli4_cfg_clk {
			#clock-cells = <0>;
			lpcm-id = <0x4>;
			clock-id = <0x8>;
			rates = <0x0 0x11e1a300>; /* 300 MHz */
		};

		lsios_cli4_i2c_clk: lsios_cli4_i2c_clk {
			#clock-cells = <0>;
			lpcm-id = <0x4>;
			clock-id = <0x16>;
			rates = <0x0 0x0bebc200>; /* 200 MHz */
		};

		lsion_cli_int2_spi_clk: lsion_cli_int2_spi_clk {
			#clock-cells = <0>;
			lpcm-id = <0x3>;
			clock-id = <0xe>;
			rates = <0x0 0x0bebc200>; /* 200 MHz */
		};

		lsion_cli_int2_cfg_clk: lsion_cli_int2_cfg_clk {
			#clock-cells = <0>;
			lpcm-id = <0x3>;
			clock-id = <0xf>;
			rates = <0x0 0x11e1a300>; /* 300 MHz */
		};

		lsion_cli_int3_spi_clk: lsion_cli_int3_spi_clk {
			#clock-cells = <0>;
			lpcm-id = <0x3>;
			clock-id = <0x13>;
			rates = <0x0 0x0bebc200>; /* 200 MHz */
		};

		lsion_cli_int3_cfg_clk: lsion_cli_int3_cfg_clk {
			#clock-cells = <0>;
			lpcm-id = <0x3>;
			clock-id = <0x14>;
			rates = <0x0 0x11e1a300>; /* 300 MHz */
		};

		lsion_cli16_cfg_clk: lsion_cli16_cfg_clk {
			#clock-cells = <0>;
			lpcm-id = <0x3>;
			clock-id = <0x1b>;
			rates = <0x0 0x11e1a300>; /* 300 MHz */
		};

		lsion_cli16_uart_clk: lsion_cli16_uart_clk {
			#clock-cells = <0>;
			lpcm-id = <0x3>;
			clock-id = <0x21>;
			rates = <0x0 0x0bebc200>; /* 200 MHz */
		};

		hsion_phy_fw_clk: hsion_phy_fw_clk {
			#clock-cells = <0>;
			lpcm-id = <0x5>;
			clock-id = <0x3>;
			rates = <0x0 0x17d78400>; /* 400 MHz */
		};

		hsion_usbc_non_sticky_clk: hsion_usbc_non_sticky_clk {
			#clock-cells = <0>;
			lpcm-id = <0x5>;
			clock-id = <0x7>;
		};

		hsion_usbc_sticky_clk: hsion_usbc_sticky_clk {
			#clock-cells = <0>;
			lpcm-id = <0x5>;
			clock-id = <0x8>;
		};

		hsion_u2phy_apb_clk: hsion_u2phy_apb_clk {
			#clock-cells = <0>;
			lpcm-id = <0x5>;
			clock-id = <0xe>;
		};

		hsion_usb2_phy_reset_clk: hsion_usb2_phy_reset_clk {
			#clock-cells = <0>;
			lpcm-id = <0x5>;
			clock-id = <0x11>;
		};

		hsion_usb3dp_phy_reset_clk: hsion_usb3dp_phy_reset_clk {
			#clock-cells = <0>;
			lpcm-id = <0x5>;
			clock-id = <0x12>;
		};

		hsios_mphy_ref_clk: hsios_mphy_ref_clk {
			#clock-cells = <0>;
			lpcm-id = <0x6>;
			clock-id = <0x1>;
			rates = <0x0 0x493e000 0x0 0x249f000>;
		};
	};

	cpm_rst: reset-controller {
		compatible = "google,cpm-rst";
		mboxes = <&goog_mba_cpm_iface>;

		lsion_resets: lsion_resets {
			#reset-cells = <1>;
			lpcm-id = <0x3>;
			reset-num = <0x2b>;
		};

		lsioe_resets: lsioe_resets {
			#reset-cells = <1>;
			lpcm-id = <0x2>;
			reset-num = <0x32>;
		};

		lsios_resets: lsios_resets {
			#reset-cells = <1>;
			lpcm-id = <0x4>;
			reset-num = <0x2d>;
		};

		hsion_resets: hsion_resets {
			#reset-cells = <1>;
			lpcm-id = <0x5>;
			reset-num = <0x10>;
		};

		hsios_resets: hsios_resets {
			#reset-cells = <1>;
			lpcm-id = <0x6>;
			reset-num = <0x5>;
		};
	};

	da9188mfd: pmic {
		compatible = "google,da9188mfd";

		da9188_regulator: da9188-regulator {
			compatible = "google,da9188-regulator";
			mba-dest-channel = <0xa>;
			mboxes = <&goog_mba_cpm_iface>;

			regulators {
				da9188 {
					ldo_10m_reg: ldo_10m {
						regulator-name = "ldo_10m";
						regulator-min-microvolt = <1200000>;
						regulator-max-microvolt = <1200000>;
						regulator-always-on;
					};

					ldo_11m_reg: ldo_11m {
						regulator-name = "ldo_11m";
						regulator-min-microvolt = <1200000>;
						regulator-max-microvolt = <1200000>;
						regulator-always-on;
					};

					ldo_14m_reg: ldo_14m {
						regulator-name = "ldo_14m";
						regulator-min-microvolt = <3100000>;
						regulator-max-microvolt = <3100000>;
					};

					ldo_24m_reg: ldo_24m {
						regulator-name = "ldo_24m";
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <1800000>;
					};

					ldo_26m_reg: ldo_26m {
						regulator-name = "ldo_26m";
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
					};
				};

				da9189 {
					ldo_18s_reg: ldo_18s {
						regulator-name = "ldo_18s";
						regulator-min-microvolt = <3100000>;
						regulator-max-microvolt = <3100000>;
					};

					ldo_26s_reg: ldo_26s {
						regulator-name = "ldo_26s";
						regulator-min-microvolt = <3300000>;
						regulator-max-microvolt = <3300000>;
					};

					ldo_27s_reg: ldo_27s {
						regulator-name = "ldo_27s";
						regulator-min-microvolt = <1800000>;
						regulator-max-microvolt = <1800000>;
					};
				};
			};
		};

		da9188_gpio: da9188-gpio {
			compatible = "google,da9188-gpio";
			mba-dest-channel = <0xa>;
			mboxes = <&goog_mba_cpm_iface>;
			gpio-controller;
			#gpio-cells = <2>;
			ngpios = <19>;
			gpio-ranges = <&da9188_gpio 0 0 19>;
		};
	};

	gpio_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&vol_dn_l &vol_up_l &pmicm2ap_gsc_pwron_od_l>;
		status = "disabled";

		button-voldn {
			label = "KEY_VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pinctrl_cpm 0x33 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-volup {
			label = "KEY_VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pinctrl_cpm 0x34 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};

		button-power {
			label = "KEY_POWER";
			linux,code = <KEY_POWER>;
			gpios = <&pinctrl_cpm 0x30 GPIO_ACTIVE_LOW>;
			wakeup-source;
		};
	};

	tpu_iovas_resv: tpu_iovas_resv {
		iommu-addresses = <&buenos 0x0 0x18000000>;
	};
	soc: soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* Stock FDT includes trailing zeroed GICC/GICH/GICV ranges; omitted here per arm,gic-v3.yaml */
		gic: interrupt-controller@5880000 {
			compatible = "arm,gic-v3";
			interrupt-controller;
			#interrupt-cells = <4>;
			reg = <0x0 0x05880000 0x0 0x10000>,
			      <0x0 0x05900000 0x0 0x200000>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;

			ppi-partitions {
				ppi_part0: interrupt-partition-0 {
					affinity = <&cpu0 &cpu1 &cpu2 &cpu3 &cpu4 &cpu5 &cpu6>;
				};
				ppi_part1: interrupt-partition-1 {
					affinity = <&cpu7>;
				};
			};
		};

		/* === CPM Mailbox & Control Plane (Stage 1B) === */
		cpm_mba_syscon: syscon@5250000 {
			compatible = "google,cpm-mba-global", "syscon";
			reg = <0x0 0x05250000 0x0 0x50>;
		};

		cpm_ap_ns_req_mba_client_0: mailbox@5260000 {
			compatible = "google,mba-ctrl";
			reg = <0x0 0x05260000 0x0 0x1000>;
			interrupts = <GIC_SPI 250 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <1>;
			google,syscon-phandle = <&cpm_mba_syscon 0>;
			queue-mode;
			payload-size = <4>;
			mba-ip-version = <2 0>;
			status = "okay";
		};

		cpm_ap_ns_resp_mba_client_1: mailbox@5261000 {
			compatible = "google,mba-ctrl";
			reg = <0x0 0x05261000 0x0 0x1000>;
			interrupts = <GIC_SPI 251 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <1>;
			google,syscon-phandle = <&cpm_mba_syscon 1>;
			queue-mode;
			payload-size = <4>;
			mba-ip-version = <2 0>;
			status = "okay";
		};


		/* === Stage 1 Watchdogs (port google_wdt.c or disarm early) === */
		watchdog_cl0: watchdog@200c4000 {
			compatible = "google,wdt";
			reg = <0x0 0x200c4000 0x0 0x1000>;
			clocks = <&oscillator>;
			timeout-sec = <24>;
			expiry-action = [00];
			key-unlock = <0xc0ffee>;
			key-lock = <0x0>;
			use-syscore-pm;
			status = "disabled";
		};

		watchdog_cl1: watchdog@200c5000 {
			compatible = "google,wdt";
			reg = <0x0 0x200c5000 0x0 0x1000>;
			clocks = <&oscillator>;
			timeout-sec = <30>;
			expiry-action = [01];
			key-unlock = <0xc0ffee>;
			key-lock = <0x0>;
			status = "disabled";
		};

		/* === Stage 1A Debug UART (direct GICv3 SPI 688, bypasses GIA) === */
		uart16: serial@db62000 {
			/* snps,dw-apb-uart fallback lets mainline 8250_dw bind before google_8250_dw */
			compatible = "goog,goog-dw-apb-uart", "snps,dw-apb-uart";
			reg = <0x0 0x0db62000 0x0 0x100>;
			reg-shift = <2>;
			reg-io-width = <4>;
			interrupts = <GIC_SPI 688 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&lsion_cli16_uart_clk>, <&lsion_cli16_cfg_clk>;
			clock-names = "baudclk", "apb_pclk";
			resets = <&lsion_resets 0x6>;
			reset-names = "s_rst_n";
			power-domains = <&lsio_n_cli_gpio_pd>;
			status = "disabled";
		};

		/* === Stage 1B USB2-Only Gadget (uses existing mainline v7.3-rc6 drivers) === */
		usb_cfg_csr: syscon@c450000 {
			compatible = "syscon";
			/* 0x30 covers 0x0..0x2f (note: dwc3-google accesses 0x2c vs stock 0x28 usb_top_cfg_csr) */
			reg = <0x0 0x0c450000 0x0 0x30>;
		};

		usb_phy: phy@c410000 {
			compatible = "google,lga-usb-phy";
			reg = <0x0 0x0c410000 0x0 0x20000>,
			      <0x0 0x0c430000 0x0 0x1000>,
			      <0x0 0x0c440000 0x0 0x10000>,
			      <0x0 0x0c637000 0x0 0xa0>;
			reg-names = "usb3_core", "usb3_tca", "usb2_core", "usbdp_top";
			#phy-cells = <1>;
			clocks = <&hsion_usb2_phy_reset_clk>, <&hsion_u2phy_apb_clk>,
				 <&hsion_usb3dp_phy_reset_clk>, <&hsion_phy_fw_clk>;
			clock-names = "usb2", "usb2_apb", "usb3", "usb3_fw";
			resets = <&hsion_resets 0xd>, <&hsion_resets 0x9>, <&hsion_resets 0xe>;
			reset-names = "usb2", "usb2_apb", "usb3";
			power-domains = <&hsio_n_usb_pd>;
			orientation-switch;
			google,usb-cfg-csr = <&usb_cfg_csr 0x14>;
			status = "disabled";
		};

		simple_usb_bus {
			compatible = "simple-bus";
			#address-cells = <2>;
			#size-cells = <2>;
			dma-ranges = <0x0 0x0 0x0 0x0 0x1 0x0>;
			ranges;

			usb: usb@c400000 {
				compatible = "google,lga-dwc3";
				reg = <0x0 0x0c400000 0x0 0xd060>;
				interrupts = <GIC_SPI 580 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 597 IRQ_TYPE_LEVEL_HIGH 0>,
					     <GIC_SPI 598 IRQ_TYPE_LEVEL_HIGH 0>;
				interrupt-names = "core", "hs_pme", "ss_pme";
				clocks = <&hsion_usbc_non_sticky_clk>, <&hsion_usbc_sticky_clk>;
				clock-names = "non_sticky", "sticky";
				resets = <&hsion_resets 0xa>, <&hsion_resets 0xb>,
					 <&hsion_resets 0xc>, <&hsion_resets 0x6>;
				reset-names = "non_sticky", "sticky", "drd_bus", "top";
				power-domains = <&hsio_n_usb_psw_pd>, <&hsio_n_usb_pd>;
				power-domain-names = "psw", "top";
				iommus = <&amb_smmu 0x8100>;
				/*
				 * Omit usb3-phy so dwc3-google enters
				 * USB2ONLY_MODE without usb_phy_fw.
				 */
				phys = <&usb_phy 0>;
				phy-names = "usb2-phy";
				dr_mode = "peripheral";
				maximum-speed = "high-speed";
				snps,quirk-frame-length-adjustment = <0x20>;
				snps,gfladj-refclk-lpm-sel-quirk;
				snps,incr-burst-type-adjustment = <4>;
				google,usb-cfg-csr = <&usb_cfg_csr 0x0 0x20>;
				status = "disabled";
			};
		};

		/* === Stage 2 Stubs (disabled; reference addresses / GIAs / IOMMUs) === */
		cpuacc_level_gia: interrupt-controller@5cd2028 {
			compatible = "google,level-gia";
			interrupt-controller;
			#interrupt-cells = <1>;
			reg = <0x0 0x05cd2028 0x0 0x10>;
			reg-names = "cpuacc_ap_ns_intr";
			interrupts = <GIC_SPI 151 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		cpuacc_pulse_gia: interrupt-controller@5cd2000 {
			compatible = "google,pulse-gia";
			interrupt-controller;
			#interrupt-cells = <1>;
			reg = <0x0 0x05cd2000 0x0 0x14>;
			interrupts-extended = <&cpuacc_level_gia 10>, <&cpuacc_level_gia 9>,
					      <&cpuacc_level_gia 8>, <&cpuacc_level_gia 7>,
					      <&cpuacc_level_gia 6>, <&cpuacc_level_gia 5>,
					      <&cpuacc_level_gia 4>, <&cpuacc_level_gia 3>,
					      <&cpuacc_level_gia 2>, <&cpuacc_level_gia 1>,
					      <&cpuacc_level_gia 0>;
			status = "disabled";
		};

		lsioe_level_gia_0: interrupt-controller@3a160000 {
			compatible = "google,level-gia";
			interrupt-controller;
			#interrupt-cells = <1>;
			reg = <0x0 0x3a160000 0x0 0x10>;
			interrupts = <GIC_SPI 700 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&lsio_e_cli_gpio_pd>;
			status = "disabled";
		};

		lsioe_level_gia_4: interrupt-controller@3a160400 {
			compatible = "google,level-gia";
			interrupt-controller;
			#interrupt-cells = <1>;
			reg = <0x0 0x3a160400 0x0 0x10>;
			interrupts = <GIC_SPI 704 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&lsio_e_cli_gpio_pd>;
			status = "disabled";
		};

		lsion_level_gia_4: interrupt-controller@d960400 {
			compatible = "google,level-gia";
			interrupt-controller;
			#interrupt-cells = <1>;
			reg = <0x0 0x0d960400 0x0 0x10>;
			interrupts = <GIC_SPI 684 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&lsio_n_cli_gpio_pd>;
			status = "disabled";
		};

		lsios_level_gia_0: interrupt-controller@3bd60000 {
			compatible = "google,wide-level-gia";
			interrupt-controller;
			#interrupt-cells = <1>;
			reg = <0x0 0x3bd60000 0x0 0x20>;
			nr-irq-chips = <2>;
			next-bank-offset = <0x10>;
			interrupts = <GIC_SPI 690 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&lsio_s_cli_gpio_pd>;
			status = "disabled";
		};

		lsios_level_gia_4: interrupt-controller@3bd60400 {
			compatible = "google,level-gia";
			interrupt-controller;
			#interrupt-cells = <1>;
			reg = <0x0 0x3bd60400 0x0 0x10>;
			interrupts = <GIC_SPI 694 IRQ_TYPE_LEVEL_HIGH 0>;
			power-domains = <&lsio_s_cli_gpio_pd>;
			status = "disabled";
		};

		uart9: serial@3a322000 {
			compatible = "goog,goog-dw-apb-uart", "snps,dw-apb-uart";
			reg = <0x0 0x3a322000 0x0 0x100>;
			reg-shift = <2>;
			reg-io-width = <4>;
			interrupts-extended = <&lsioe_level_gia_4 2>;
			status = "disabled";
		};

		pinctrl_cpm: pinctrl@5280000 {
			compatible = "google,lga-cpm-pinctrl";
			reg = <0x0 0x05280000 0x0 0x39000>;
			gpio-controller;
			gpio-ranges = <&pinctrl_cpm 0 0 0x39>;
			#gpio-cells = <2>;
			gpio-reserved-ranges = <0x0 0x6>;
			sswrp-wakeup-capable;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupts = <GIC_SPI 0x27f IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x27e IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x27d IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x27c IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x27b IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x27a IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x279 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x278 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x277 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x276 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x275 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x274 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x273 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x272 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x271 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x26f IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x26e IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x26d IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x26c IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x26b IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x26a IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x262 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x261 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x264 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x263 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x25d IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x25c IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x25b IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x269 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x268 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x267 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x266 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x265 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x270 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x260 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x25f IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x25e IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x25a IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x259 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x258 IRQ_TYPE_LEVEL_HIGH 0>;
			irq-pad-mapping = <0x6 0x7 0xa 0xb 0x11 0x12 0x13 0x14
					   0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c
					   0x1d 0x1e 0x1f 0x20 0x21 0x24 0x25 0x26
					   0x27 0x28 0x29 0x2a 0x2c 0x2d 0x2e 0x2f
					   0x30 0x31 0x33 0x34 0x35 0x36 0x37 0x38>;
			status = "disabled";

			pmicm2ap_gsc_pwron_od_l: pmicm2ap_gsc_pwron_od_l {
				pins = "XCPM_GPI0";
				bias-pull-up;
				input-enable;
				output-disable;
				function = "cpm_int";
			};

			vol_dn_l: vol_dn_l {
				pins = "XCPM_GPI1";
				bias-pull-up;
				input-enable;
				output-disable;
				function = "cpm_int";
			};

			vol_up_l: vol_up_l {
				pins = "XCPM_EINT_12";
				bias-disable;
				input-enable;
				output-disable;
				function = "cpm_int";
			};

			hall1_2_aoc_ap_l: hall1_2_aoc_ap_l {
				pins = "XCPM_EINT_16";
				bias-pull-up;
				input-enable;
				output-disable;
				function = "cpm_int";
			};
		};

		pinctrl_aoc: pinctrl@b400000 {
			compatible = "google,lga-aoc-pinctrl";
			reg = <0x0 0x0b400000 0x0 0x5b000>,
			      <0x0 0x052b9000 0x0 0x12000>;
			power-domains = <&sswrp_aoc_pd>;
			power-domain-names = "pad_function_pd";
			gpio-controller;
			gpio-ranges = <&pinctrl_aoc 0 0 0x5b>;
			#gpio-cells = <2>;
			gpio-reserved-ranges = <0x1 0x1 0x3 0x1 0x5 0x1 0x7 0x1
						0x8 0x1 0x1e 0x1 0x22 0x1 0x3b 0x1>;
			sswrp-wakeup-capable;
			shared-pads = <0xc 0xd 0xe 0xf 0x10 0x11 0x16 0x17 0x18
				       0x19 0x29 0x2a 0x37 0x38 0x39 0x3a 0x41 0x42>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupts = <GIC_SPI 0x28e IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x28d IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x28c IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x28b IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x28a IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x289 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x288 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x287 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x284 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x283 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x282 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x281 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x286 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 0x285 IRQ_TYPE_LEVEL_HIGH 0>;
			irq-pad-mapping = <0xc 0xd 0x16 0x17 0x18 0x19 0x29 0x2a
					   0x37 0x38 0x39 0x3a 0x41 0x42>;
			status = "disabled";

			ts0_2_aoc_int_l_1v2: ts0_2_aoc_int_l_1v2 {
				pins = "XAOC_GPIO12";
				bias-pull-up;
				input-enable;
				output-disable;
				function = "aoc_cpm_eint";
			};

			ts1_2_aoc_int_l_1v2: ts1_2_aoc_int_l_1v2 {
				pins = "XAOC_GPIO13";
				bias-pull-up;
				input-enable;
				output-disable;
				function = "aoc_cpm_eint";
			};

			cli19_int2_spi_clk_mosi_miso_func: cli19_int2_spi_clk_mosi_miso_func {
				pins = "XAOC_SPI2_SCLK", "XAOC_SPI2_MOSI", "XAOC_SPI2_MISO";
				function = "aoc_cli_int_2";
				bias-pull-down;
				output-disable;
				input-enable;
			};

			cli19_int2_spi_cs_gpio_func: cli19_int2_spi_cs_gpio_func {
				pins = "XAOC_SPI2_SSB";
				function = "aoc_int_gpio";
				bias-disable;
				drive-strength = <0x4>;
				input-enable;
				output-enable;
			};

			cli20_int3_spi_clk_mosi_miso_func: cli20_int3_spi_clk_mosi_miso_func {
				pins = "XAOC_SPI3_SCLK", "XAOC_SPI3_MOSI", "XAOC_SPI3_MISO";
				function = "aoc_cli_int_3";
				bias-pull-down;
				output-disable;
				input-enable;
			};

			cli20_int3_spi_cs_gpio_func: cli20_int3_spi_cs_gpio_func {
				pins = "XAOC_SPI3_SSB";
				function = "aoc_int_gpio";
				bias-disable;
				drive-strength = <0x4>;
				input-enable;
				output-enable;
			};
		};

		pinctrl_lsioe: pinctrl@3a200000 {
			compatible = "google,lga-lsioe-pinctrl";
			reg = <0x0 0x3a200000 0x0 0x20000>;
			clocks = <&lsioe_gpio_clk>;
			clock-names = "gpio_clk";
			power-domains = <&lsio_e_cli_gpio_pd>, <&sswrp_lsio_e_pd>;
			power-domain-names = "csr_access_pd", "pad_function_pd";
			gpio-controller;
			gpio-ranges = <&pinctrl_lsioe 0 0 0x20>;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupts-extended = <&lsioe_level_gia_0 0x0>, <&lsioe_level_gia_0 0x1>,
					      <&lsioe_level_gia_0 0x2>, <&lsioe_level_gia_0 0x3>,
					      <&lsioe_level_gia_0 0x4>, <&lsioe_level_gia_0 0x5>,
					      <&lsioe_level_gia_0 0x6>, <&lsioe_level_gia_0 0x7>,
					      <&lsioe_level_gia_0 0x18>, <&lsioe_level_gia_0 0x19>,
					      <&lsioe_level_gia_0 0x1a>, <&lsioe_level_gia_0 0x1b>,
					      <&lsioe_level_gia_0 0x8>, <&lsioe_level_gia_0 0x9>,
					      <&lsioe_level_gia_0 0xa>, <&lsioe_level_gia_0 0xb>,
					      <&lsioe_level_gia_0 0xc>, <&lsioe_level_gia_0 0xd>,
					      <&lsioe_level_gia_0 0xe>, <&lsioe_level_gia_0 0xf>,
					      <&lsioe_level_gia_0 0x10>, <&lsioe_level_gia_0 0x11>,
					      <&lsioe_level_gia_0 0x12>, <&lsioe_level_gia_0 0x13>,
					      <&lsioe_level_gia_0 0x14>, <&lsioe_level_gia_0 0x15>,
					      <&lsioe_level_gia_0 0x16>, <&lsioe_level_gia_0 0x17>,
					      <&lsioe_level_gia_0 0x1c>, <&lsioe_level_gia_0 0x1d>,
					      <&lsioe_level_gia_0 0x1e>, <&lsioe_level_gia_0 0x1f>;
			irq-pad-mapping = <0x0 0x1 0x2 0x3 0x4 0x5 0x6 0x7
					   0x8 0x9 0xa 0xb 0xc 0xd 0xe 0xf
					   0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17
					   0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1e 0x1f>;
			status = "disabled";

			cli14_2_wire_func: cli14_2_wire_func {
				pins = "XLSIOE_CLI14_PIN0", "XLSIOE_CLI14_PIN1";
				function = "lsioe_cli14";
				drive-strength = <0x0>;
				output-disable;
				input-enable;
